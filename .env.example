# Copy this file to .env and fill in your own values.
# Never commit the real .env - it holds your DSM credentials.

# Synology DSM connection
DSM_URL=https://your-dsm-host-or-ip
DSM_USERNAME=your-dsm-username
DSM_PASSWORD=your-dsm-password

# Address that receives spam reports (used by the VBA "Spam" button)
SPAM_REPORT_EMAIL=spam@yourdomain.com

# Optional: run without a visible browser (default true)
MAILPLUS_HEADLESS=true
